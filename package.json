{
	"name": "healthymartina-react-front",
	"version": "1.0.0",
	"description": "React frontend for Healthy Martina - Refactored from lista-dj.js",
	"main": "src/index.js",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"keywords": [
		"react",
		"recipe",
		"nutrition",
		"unit-conversion"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@tanstack/react-query": "^5.90.12",
		"axios": "^1.13.2",
		"fractional": "^1.0.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-icons": "^5.5.0",
		"react-router-dom": "^6.22.0",
		"sass": "^1.94.2",
		"unitz": "^0.6.0",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@babel/core": "^7.23.0",
		"@babel/preset-env": "^7.23.0",
		"@babel/preset-react": "^7.22.0",
		"@tanstack/react-query-devtools": "^5.91.1",
		"@testing-library/jest-dom": "^6.1.0",
		"@testing-library/react": "^13.4.0",
		"@vitejs/plugin-react": "^4.2.1",
		"babel-jest": "^29.7.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"vite": "^5.1.0"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"transform": {
			"^.+\\.(js|jsx)$": "babel-jest"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!(fractional|unitz)/)"
		],
		"setupFilesAfterEnv": [
			"<rootDir>/src/setupTests.js",
			"@testing-library/jest-dom"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/src/$1"
		},
		"collectCoverageFrom": [
			"src/**/*.{js,jsx}",
			"!src/**/*.test.{js,jsx}",
			"!src/index.js"
		]
	}
}
