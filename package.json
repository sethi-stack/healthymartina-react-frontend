{
    "name": "healthymartina-react-front",
    "version": "1.0.0",
    "description": "React frontend for Healthy Martina - Refactored from lista-dj.js",
    "main": "src/index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "react",
        "recipe",
        "nutrition",
        "unit-conversion"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "fractional": "^1.0.0",
        "unitz": "^0.6.0"
    },
    "devDependencies": {
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.23.0",
        "@babel/preset-react": "^7.22.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/jest-dom": "^6.1.0",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "transform": {
            "^.+\\.(js|jsx)$": "babel-jest"
        },
        "transformIgnorePatterns": [
            "node_modules/(?!(fractional|unitz)/)"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/src/setupTests.js",
            "@testing-library/jest-dom"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "collectCoverageFrom": [
            "src/**/*.{js,jsx}",
            "!src/**/*.test.{js,jsx}",
            "!src/index.js"
        ]
    }
}
