##
## HealthyMartina React — Cloudflare Pages build environment
## Set these in: Cloudflare Pages → Settings → Environment Variables → Production
##

# URL of your DigitalOcean Droplet Laravel API (with trailing slash removed)
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Feature flag: route recipe/lista exports through async external export API
# false => use legacy direct Laravel PDF endpoints
# true  => use /calendars/export/pdf/start + poll + download flow
VITE_USE_EXTERNAL_EXPORT_API=false
